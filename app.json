{
  "expo": {
    "name": "Agenda Juridica",
    "slug": "agenda-juridica",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "agendajuridica",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.agendajuridica.app"
    },
    "android": {
      "package": "com.agendajuridica.app",
      "adaptiveIcon": {
        "backgroundColor": "#04192F",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#04192F",
          "imageWidth": 240
        }
      ],
      "expo-sqlite",
      "expo-notifications",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Permita que o Agenda Juridica use o Face ID para proteger seus compromissos."
        }
      ],
      "expo-secure-store",
      "expo-sharing",
      "expo-localization",
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
